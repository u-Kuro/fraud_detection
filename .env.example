Continue. But I want to change some stuff:

```
For DAGs: all test files are located under `root/tests/unit/`. The structure inside this path is a strict 1-to-1 copy of `root/dags/`. The same rule applies: exact same directory names, exact same directory locations, exact same file names, exact same file locations, and the internal code sequence of each test file mirrors the internal code sequence of its corresponding DAG file.
```

It should've been this:

```
For DAGs: all test files are located under `root/tests/dags/unit/`. The structure inside this path is a strict 1-to-1 copy of `root/dags/`. This structure will help put files like `root/tests/dags/Dockerfile` service in root. The same rule applies: exact same directory names, exact same directory locations, exact same file names, exact same file locations, and the internal code sequence of each test file mirrors the internal code sequence of its corresponding DAG file.
```

Also separate test group in pyproject.toml e.g.:

```
test = [
    "pytest>=9.1.1",
    "pytest-env>=1.7.0",
    "pytest-mock>=3.15.1",
]
```

While the docker-compose.test.yaml can look like this, you can change it based on how you built the code:

```
services:
  atlas-postgres:
    image: postgres:15
    ports: [ "5433:5433" ]
    environment:
      PGPORT: 5433
      POSTGRES_DB: postgres
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U postgres -d postgres" ]
      interval: 10s
      timeout: 5s
      retries: 5

  atlas-migrate-lint:
    image: arigaio/atlas:1.3.2-community-alpine
    working_dir: /app
    volumes:
      - ./database:/database
    environment:
      - DEV_URL=postgres://postgres:postgres@atlas-postgres:5433/postgres?search_path=public&sslmode=disable
    command: [ "migrate", "lint", "--env", "test" ]
    depends_on:
      atlas-postgres:
        condition: service_healthy

  dags-tests:
    build:
      context: .
      dockerfile: tests/dags/Dockerfile
      # target: test # Can be removed since its only single stage since we are not pushing an image

  archive-tests:
    build:
      context: .
      dockerfile: services/archive/Dockerfile
      target: test

  drift-check-tests:
    build:
      context: .
      dockerfile: services/drift_check/Dockerfile
      target: test

  fraud-detection-tests:
    build:
      context: .
      dockerfile: services/fraud_detection/Dockerfile
      target: test

  train-model-tests:
    build:
      context: .
      dockerfile: services/train_model/Dockerfile
      target: test
```


