docker network rm ministack-network
docker volume rm ministack
Start-Sleep -Seconds 5
clear
docker network create ministack-network
docker run -d `
  --name ministack `
  --network ministack-network `
  -p 4566:4566 `
  -e DOCKER_NETWORK=ministack-network `
  -e PERSIST_STATE=1 `
  -e LOCALSTACK_PERSISTENCE=1 `
  -e S3_PERSIST=1 `
  -e RDS_PERSIST=1 `
  -e MWAA_PERSIST=1 `
  -e DSQL_PERSIST=1 `
  -e DSQL_STRICT=1 `
  -e LOG_LEVEL=DEBUG `
  -v /var/run/docker.sock:/var/run/docker.sock `
  ministackorg/ministack
Start-Sleep -Seconds 5
Invoke-RestMethod -Uri "http://localhost:4566/_ministack/health"
.\test-eks-traefik-ingressroute.ps1

