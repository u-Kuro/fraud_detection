docker network rm ministack_network
Start-Sleep -Seconds 5
clear
docker network create ministack_network
docker run -d `
  --name ministack `
  --network ministack_network `
  -p 4566:4566 `
  -e GATEWAY_PORT=4566 `
  -e LOG_LEVEL=INFO `
  -e DOCKER_NETWORK=ministack_network `
  -v ministack-data:/tmp/ministack-data `
  -v /var/run/docker.sock:/var/run/docker.sock `
  ministackorg/ministack:latest
Start-Sleep -Seconds 5
Invoke-RestMethod -Uri "http://localhost:4566/_ministack/health"
.\test-eks-traefik-ingressroute.ps1


