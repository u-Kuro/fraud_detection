name: Build and Copy Directory
on: [push]

jobs:
  docker-copy-job:
    runs-on: ubuntu-latest
    steps:
      # 1. Check out your repository
      - name: Checkout Repository
        uses: actions/checkout@v4

      # 2. Build or start your destination container
      - name: Start Target Container
        run: |
          docker run -d --name my_target_container alpine sleep 300

      # 3. Copy the directory from checkout to the container (MWAA s3 auto sync currently not implemented in Ministack. invoking existing dag in airflow does work tho.)
      - name: Copy Directory to Docker Container
        run: |
          docker cp ${{ github.workspace }}/dags/. airflow_container_name:/opt/airflow/dags/

