ECR + EKS
# ════════════════════════════════════════════════════════════════════
# LocalStack EKS → ECR → k3s registries.yaml → Pod (all temp files)
# ════════════════════════════════════════════════════════════════════

# ── Variables ────────────────────────────────────────────────────────
$region             = "us-east-1"
$accountId          = "000000000000"
$repoName           = "myteam/test-app"
$clusterName        = "test-cluster"
$k3sContainerName   = "ministack-eks-${clusterName}"
$ministackContainer = "ministack"
$k3sInternalPort    = 6443
$k3sHostPort        = 16443
$k3sConfigDir       = "/etc/rancher/k3s"
$localstackPort     = 4566
$localstackEndpoint = "http://localhost:${localstackPort}"
$eksClusterRoleArn  = "arn:aws:iam::${accountId}:role/eks-cluster-role"
$ecrRoleArn         = "arn:aws:iam::${accountId}:role/mle-team-role"

# Host → Docker Desktop uses localhost.localstack.cloud for push
# Pod manifest uses amazonaws.com → k3s mirrors it to ministack via registries.yaml
$ecrUriHost  = "${accountId}.dkr.ecr.${region}.localhost.localstack.cloud:${localstackPort}"
$ecrUriReal  = "${accountId}.dkr.ecr.${region}.amazonaws.com"
$imageUriPod = "${ecrUriReal}/${repoName}:latest"


# ── 1. Create EKS Cluster ────────────────────────────────────────────
Write-Host "`n=== [EKS] Create Cluster ===" -ForegroundColor Cyan
# LocalStack ignores the actual subnet/SG IDs; any placeholder values work
aws eks create-cluster `
    --name $clusterName `
    --role-arn $eksClusterRoleArn `
    --resources-vpc-config 'subnetIds=["subnet-xxxxxx","subnet-yyyyyy"],securityGroupIds=["sg-xxxxxx","sg-xxxxxy"]' `
    --kubernetes-version "1.32" `
    --endpoint-url $localstackEndpoint


# ── 2. Wait for Cluster ACTIVE ───────────────────────────────────────
Write-Host "`n=== [EKS] Waiting for cluster to become ACTIVE ===" -ForegroundColor Cyan
aws eks wait cluster-active --name $clusterName --endpoint-url $localstackEndpoint
Write-Host "Cluster ACTIVE." -ForegroundColor Green


# ── 3. Create ECR Repository ─────────────────────────────────────────
Write-Host "`n=== [ECR] Create Repository ===" -ForegroundColor Cyan
aws ecr create-repository `
    --repository-name $repoName `
    --image-tag-mutability MUTABLE `
    --endpoint-url $localstackEndpoint


# ── 4. Set ECR Policy ────────────────────────────────────────────────
Write-Host "`n=== [ECR] Set Repository Policy ===" -ForegroundColor Cyan
$policy = @{
    Statement = @(
        @{
            Effect    = "Allow"
            Action    = "ecr:*"
            Resource  = "*"
            Principal = @{ AWS = $ecrRoleArn }
        }
    )
} | ConvertTo-Json -Depth 5 -Compress

$tmpPolicy = [System.IO.Path]::GetTempFileName()
[System.IO.File]::WriteAllText($tmpPolicy, $policy)
aws ecr set-repository-policy `
    --repository-name $repoName `
    --policy-text "file://$tmpPolicy" `
    --endpoint-url $localstackEndpoint
Remove-Item $tmpPolicy


# ── 5. Build Docker Image (temp build dir, not cwd) ──────────────────
Write-Host "`n=== [Docker] Build Image ===" -ForegroundColor Cyan
$tmpBuildDir = Join-Path ([System.IO.Path]::GetTempPath()) "docker-build-$(Get-Random)"
New-Item -ItemType Directory -Path $tmpBuildDir | Out-Null

# Single-quoted here-string: no variable expansion, no escaping needed
[System.IO.File]::WriteAllText((Join-Path $tmpBuildDir "Dockerfile"), @'
FROM python:3.12.11-slim
CMD ["python", "-c", "import time; [(__import__('time').sleep(2), print(f'[{i}] Hello from EKS container!', flush=True)) for i in range(10)]"]
'@)

docker build -t test-app $tmpBuildDir
Remove-Item -Recurse -Force $tmpBuildDir


# ── 6. Login and Push to LocalStack ECR ─────────────────────────────
Write-Host "`n=== [ECR] Login and Push ===" -ForegroundColor Cyan
aws ecr get-login-password --endpoint-url $localstackEndpoint |
    docker login --username AWS --password-stdin $ecrUriHost

docker tag  test-app:latest "${ecrUriHost}/${repoName}:latest"
docker push "${ecrUriHost}/${repoName}:latest"


# ── 7. Get kubeconfig from k3s container ────────────────────────────
# CRITICAL: docker exec returns a string array in PowerShell.
# WriteAllText joins arrays with spaces by default → corrupts YAML → kubectl fails.
# -join "`n" forces proper newlines before the replace.
Write-Host "`n=== [K3s] Setup kubeconfig ===" -ForegroundColor Cyan
$rawKubeconfig  = docker exec $k3sContainerName cat "${k3sConfigDir}/k3s.yaml"
$tempKubeconfig = [System.IO.Path]::GetTempFileName()
[System.IO.File]::WriteAllText(
    $tempKubeconfig,
    (($rawKubeconfig -join "`n") -replace "https://127\.0\.0\.1:${k3sInternalPort}", "https://127.0.0.1:${k3sHostPort}")
)
$env:KUBECONFIG = $tempKubeconfig


# ── 8. Write registries.yaml into k3s container ──────────────────────
# Mirrors amazonaws.com URI → ministack container name (reachable in Docker network).
# localhost would resolve to the k3s container itself, not the host — so container name is used.
Write-Host "`n=== [K3s] Apply registries.yaml ===" -ForegroundColor Cyan
$ecrPassword = aws ecr get-login-password --endpoint-url $localstackEndpoint

$tmpRegistries = [System.IO.Path]::GetTempFileName()
[System.IO.File]::WriteAllText($tmpRegistries, @"
mirrors:
  "${ecrUriReal}": # "${accountId}.dkr.ecr.${region}.amazonaws.com"
    endpoint:
      - "http://${ministackContainer}:${localstackPort}" # ministack | 4566
configs:
  "${ministackContainer}:${localstackPort}": # ministack | 4566
    auth:
      username: "AWS"
      password: "${ecrPassword}" # aws ecr get-login-password --endpoint-url "http://localhost:${4566}"
"@)

docker cp $tmpRegistries "${k3sContainerName}:${k3sConfigDir}/registries.yaml"
Remove-Item $tmpRegistries


# ── 9. Restart k3s and wait for recovery ────────────────────────────
Write-Host "`n=== [K3s] Restarting ===" -ForegroundColor Cyan
docker restart $k3sContainerName

$maxWait = 120; $elapsed = 0
do {
    Start-Sleep -Seconds 5
    $elapsed += 5
    kubectl get nodes --request-timeout=5s 2>&1 | Out-Null
    Write-Host "  Still waiting... ${elapsed}s"
} until ($LASTEXITCODE -eq 0 -or $elapsed -ge $maxWait)

if ($elapsed -ge $maxWait) { Write-Error "k3s did not recover after ${maxWait}s"; exit 1 }
Write-Host "Cluster ready." -ForegroundColor Green
kubectl get nodes


# ── 10. Deploy Pod ───────────────────────────────────────────────────
# CRITICAL: pod image must use amazonaws.com URI (not localhost.localstack.cloud).
# The localhost.localstack.cloud URI resolves to 127.0.0.1 inside k3s (itself), bypassing the mirror.
# The amazonaws.com URI hits the mirror → gets rewritten to http://ministack:4566 → works.
Write-Host "`n=== [K8s] Deploy Pod ===" -ForegroundColor Cyan
kubectl delete pod test-logger --ignore-not-found

$tmpManifest = Join-Path ([System.IO.Path]::GetTempPath()) "test-logger-pod-$(Get-Random).yaml"
[System.IO.File]::WriteAllText($tmpManifest, @"
apiVersion: v1
kind: Pod
metadata:
  name: test-logger
spec:
  containers:
    - name: test-logger
      image: ${imageUriPod}
      imagePullPolicy: Always
  restartPolicy: Never
"@)

Write-Host "Pod image URI: $imageUriPod"   # must end in amazonaws.com/...
kubectl apply -f $tmpManifest
Remove-Item $tmpManifest

kubectl wait pod/test-logger --for=condition=Ready --timeout=120s
kubectl logs test-logger --follow