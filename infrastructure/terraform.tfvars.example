    --image-tag-mutability MUTABLE
{
    "repository": {
        "repositoryArn": "arn:aws:ecr:us-east-1:000000000000:repository/myteam/test-app",
        "registryId": "000000000000",
        "repositoryName": "myteam/test-app",
        "repositoryUri": "000000000000.dkr.ecr.us-east-1.amazonaws.com/myteam/test-app",
        "createdAt": "2026-08-20T11:50:57+08:00",
        "imageTagMutability": "MUTABLE",
        "imageScanningConfiguration": {
            "scanOnPush": false
        },
        "encryptionConfiguration": {
            "encryptionType": "AES256"
        }
    }
}
# Build the policy
$policy = @{
    Statement = @(
        @{
            Effect    = "Allow"
            Action    = "ecr:*"
            Resource  = "*"
            Principal = @{
                AWS = $roleArn
            }
        }
    )
} | ConvertTo-Json -Depth 5 -Compress
# Write policy to temp file (avoid BOM + quoting issues)
$tmpFile = [System.IO.Path]::GetTempFileName()
[System.IO.File]::WriteAllText($tmpFile, $policy)
# Attach policy to repository
aws ecr set-repository-policy `
    --repository-name $repoName `
    --policy-text "file://$tmpFile"


name: Build and Copy Directory
on: [push]

jobs:
  docker-copy-job:
    runs-on: ubuntu-latest
    steps:
      # 1. Check out your repository
      - name: Checkout Repository
        uses: actions/checkout@v4

      # 2. Build or start your destination container
      - name: Start Target Container
        run: |
          docker run -d --name my_target_container alpine sleep 300

      # 3. Copy the directory from checkout to the container (MWAA s3 auto sync currently not implemented in Ministack. invoking existing dag in airflow does work tho.)
      - name: Copy Directory to Docker Container
        run: |
          docker cp ${{ github.workspace }}/dags/. airflow_container_name:/opt/airflow/dags/

