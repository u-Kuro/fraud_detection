aws ssm put-parameter `
 --name  $ssmParamName `
 --value $ssmParamValue `
 --type  String `
 --overwrite # Replace if exists else errors
aws ssm put-parameter `
 --name  $ssmSecureName `
 --value $ssmSecureValue `
 --type  SecureString `
 --overwrite # Replace if exists else errors
# Read
$plain = (aws ssm get-parameter --name $ssmParamName | ConvertFrom-Json).Value
$secret = (aws ssm get-parameter --name $ssmSecureName --with-decryption | ConvertFrom-Json).Value
$multiResult = aws ssm get-parameters --names $ssmParamName $ssmSecureName --with-decryption | ConvertFrom-Json
foreach ($param in $multiResult.Parameters) { $param.Value }

